# FastAPI Server Configuration
PROJECT_NAME="BISync - Smart Indian Standards Assistant Backend"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origin for Frontend (e.g. Vite default http://localhost:5173)
FRONTEND_URL="http://localhost:5173"

# JWT Authentication Secret Key (Generate a secure key for production)
SECRET_KEY="bisync-development-secret-key-replace-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI-compatible provider configuration. Leave blank for offline retrieval mode.
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="bis-reasoner-v2.5"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_EMBEDDING_DIMENSIONS=256

# Persistent RAG index and ingestion controls
RAG_STORE_PATH="data/rag/index.json"
RAG_DOCUMENTS_DIR="data/rag/documents"
RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
