# FastAPI Server Configuration
PROJECT_NAME="BISync - Smart Indian Standards Assistant Backend"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origin for Frontend (e.g. Vite default http://localhost:5173)
FRONTEND_URL="http://localhost:5173"

# JWT Authentication Secret Key (Generate a secure key for production)
SECRET_KEY="bisync-development-secret-key-replace-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional AI Provider API Key (e.g. OpenAI, Anthropic, or Gemini)
# If left blank, the backend operates in intelligent structured mock mode
AI_API_KEY=""
AI_MODEL="bis-reasoner-v2.5"
